# 复制为 .env 后填写。禁止提交 .env。

# ---------- 模型厂商（只有网关读取）----------
# 各家 OpenAI 兼容接口地址，以官方文档为准
HUNYUAN_API_BASE=
HUNYUAN_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=
DASHSCOPE_API_BASE=
DASHSCOPE_API_KEY=

# ---------- 网关 ----------
GATEWAY_INTERNAL_KEY=change-me        # core 调用网关时携带的内部密钥
GATEWAY_MODELS_FILE=models.yaml
GATEWAY_TIMEOUT_SECONDS=             # 留空则使用 models.yaml 里的 settings.timeout_seconds
GATEWAY_LOG_LEVEL=INFO

# ---------- core ----------
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
JWT_SECRET=change-me-to-a-random-string-of-32-chars   # 至少 32 字节
LLM_GATEWAY_BASE=http://localhost:8100/v1
LLM_GATEWAY_KEY=change-me             # 与 GATEWAY_INTERNAL_KEY 一致
LLM_DEFAULT_GROUP=chat-agent
LLM_EMBED_GROUP=embed
EMBEDDING_DIMS=1024                   # 与迁移里的向量维度一致；换 Embedding 模型需要新迁移
DEFAULT_PACK=llm_deploy
LLM_TIMEOUT_SECONDS=30
UPLOAD_DIR=./data/uploads

# ---------- web ----------
CORE_INTERNAL_URL=http://localhost:8000

# ---------- 数据库（docker compose）----------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
