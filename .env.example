# 复制为 .env 后填写。禁止提交 .env。

# ---------- 模型厂商（只有网关读取）----------
# 各家 OpenAI 兼容接口地址：留空就用 models.yaml 里的官方默认地址，走代理或私有部署时再填。至少配一家 chat 模型；知识库需要 Embedding（默认用混元）。
# 只填了部分厂商也能启动：没填 Key 的模型在网关里标记为不可用，分组会自动跳过。
# 也可以留空，由管理员在网页「系统设置 → 模型接入」里填写（加密存库，优先于这里，保存后立即生效）。
# 腾讯混元：控制台「API Key 管理」创建
HUNYUAN_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_API_KEY=
# DeepSeek：platform.deepseek.com
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# 通义千问（百炼 DashScope 兼容模式）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# 硅基流动（SiliconFlow）：cloud.siliconflow.cn
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# ---------- 网关 ----------
# core 调用网关时携带的内部密钥
GATEWAY_INTERNAL_KEY=change-me
GATEWAY_MODELS_FILE=models.yaml
# 留空则使用 models.yaml 里的 settings.timeout_seconds
GATEWAY_TIMEOUT_SECONDS=
GATEWAY_LOG_LEVEL=INFO

# ---------- core ----------
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
# 至少 32 字节（openssl rand -hex 32）；正式模式下还是默认值或太短，core 拒绝启动
JWT_SECRET=change-me-to-a-random-string-of-32-chars
# 网页登录态放在 HttpOnly Cookie（sp_session）里。Secure 标记默认按请求自动判断（HTTPS / nginx 的 X-Forwarded-Proto）；
# 需要强制时设 true / false
# COOKIE_SECURE=
# 访问口令：部署到公网时设置，登录页需要先输入口令；留空表示不需要（本地开发）
ACCESS_CODE=
# 登录页显示演示账户（一键进入、左下角切换）；正式使用改成 false，只能账号密码登录。
# false 即「正式模式」：默认密钥 / 默认数据库密码拒绝启动，演示账号不能用下面的公开初始密码登录
DEMO_LOGIN=true
# 部署在 nginx 后面时为 true（docker-compose.prod.yml 已设置）：登录失败锁定按 nginx 给的真实来源 IP 计数。
# 没有 nginx、core 直接对外时必须是 false，否则伪造请求头就能绕过锁定
TRUST_PROXY_HEADERS=false
# 网页「系统设置 → 模型接入」里填写的 Key 的加密密钥（openssl rand -hex 32）；正式模式下必须设置。
# 没设置时退回用 JWT_SECRET 加密；设置后旧密文仍能解开，下次保存时换成新密钥。两个都换掉，网页上的 Key 要重新填写
MODEL_KEYS_SECRET=
# 模型接口地址允许指向内网 / 本机（自建 vLLM、Ollama）。默认禁止（演示模式也禁止：演示站任何人都能进管理员）。
# 打开后云元数据（169.254.0.0/16、100.100.100.200 等）仍然禁止
# MODEL_ALLOW_PRIVATE_BASE=true
# 演示账户（zhangchen / liwei / wanglei / zhoumin）的初始密码，迁移和种子数据写入
DEMO_PASSWORD=demo2026
# 定时任务（到期 / 逾期 / 停滞提醒、日报催交、公海回收）在 core 进程内运行；多实例部署时数据库保证每个任务一天只跑一次
SCHEDULER_ENABLED=true
LLM_GATEWAY_BASE=http://localhost:8100/v1
# 与 GATEWAY_INTERNAL_KEY 一致
LLM_GATEWAY_KEY=change-me
LLM_DEFAULT_GROUP=chat-agent
LLM_EMBED_GROUP=embed
LLM_RERANK_GROUP=rerank
# 检索后重排（true/false）；重排不可用时自动退回向量顺序
RAG_RERANK=true
# 与迁移里的向量维度一致；换 Embedding 模型需要新迁移
EMBEDDING_DIMS=1024
DEFAULT_PACK=llm_deploy
LLM_TIMEOUT_SECONDS=30
# 企业微信群机器人 Webhook（可选，形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…；
# 也可以在网页「系统设置 → 消息推送」里填写）。key 等同密码，不要提交到仓库
WECOM_WEBHOOK_URL=
# 推送消息里的链接前缀，部署后改成对外访问的网页地址
WEB_BASE_URL=http://127.0.0.1:3005
# 客户外部情报（工商 / 舆情 / 招投标）数据源；目前只有 demo（演示数据，非真实信息）
INTEL_PROVIDER=demo
UPLOAD_DIR=./data/uploads

# ---------- web ----------
CORE_INTERNAL_URL=http://localhost:8000

# ---------- 数据库（docker compose）----------
POSTGRES_USER=crm
# 正式部署必须改成随机强密码（首次启动前改；已有数据卷再改要同时在库里 ALTER USER）
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# ---------- 反向代理（docker compose --profile prod）----------
# 本地默认 8080；正式部署（docker-compose.prod.yml）设为 80，HTTPS 端口默认 443
NGINX_PORT=8080
NGINX_HTTPS_PORT=443
